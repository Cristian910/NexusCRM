# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed origins for CORS. Leave unset locally
# (defaults to "*"). In production, set this to your Vercel URL, e.g.:
# CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=

# Database
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/crm_db?schema=public"

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Email (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=CRM System
EMAIL_FROM_ADDRESS=noreply@yourcrm.com

# Redis (BullMQ + cache)
# Local dev: leave REDIS_URL empty, HOST/PORT/PASSWORD below are used instead.
# Production (Upstash or any managed Redis): set REDIS_URL to the full
# connection string — "rediss://" (note the double "s") enables TLS, which
# Upstash requires. When REDIS_URL is set it takes priority over the three
# fields below. Example: REDIS_URL=rediss://default:AbC123@usw1-abc.upstash.io:6379
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Job config
TASK_REMINDER_HOURS_BEFORE=24

# Analytics cache
ANALYTICS_CACHE_TTL=300
ANALYTICS_CACHE_OVERVIEW_TTL=60
